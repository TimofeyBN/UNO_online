<% size = local_assigns[:size] || "md" %>
<div class="logo logo--<%= size %>">
  <span class="logo__mark">
    <span class="logo__dot" style="background: var(--suit-red)"></span>
    <span class="logo__dot" style="background: var(--suit-yellow)"></span>
    <span class="logo__dot" style="background: var(--suit-green)"></span>
    <span class="logo__dot" style="background: var(--suit-blue)"></span>
  </span>
  <span class="logo__text">Uno Online</span>
</div>
