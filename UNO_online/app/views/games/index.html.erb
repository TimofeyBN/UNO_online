<% content_for :title, "Uno Online" %>

<div class="main-page">
  <header class="main-header">
    <%= render "shared/logo" %>
    <div class="main-header__user">
      <span class="main-header__avatar"><%= current_user.name.first.upcase %></span>
      <span><%= current_user.name %></span>
      <%= button_to "Выйти", logout_path, method: :delete, class: "main-header__logout" %>
    </div>
  </header>

  <div class="main-content">
    <section class="create-room">
      <h2 class="room-list__title">Создать комнату</h2>

      <%= form_with url: games_path, method: :post, local: true, class: "create-room-form" do %>
        <div class="field-row">
          <div class="field">
            <span class="field__label">Видимость</span>
            <div class="radio-group">
              <label class="radio-option">
                <%= radio_button_tag :visibility, "public", true %>
                Публичная
              </label>
              <label class="radio-option">
                <%= radio_button_tag :visibility, "private", false %>
                Приватная (по коду)
              </label>
            </div>
          </div>

          <div class="field field--narrow">
            <label class="field__label" for="max_players">Игроков</label>
            <select name="max_players" id="max_players" class="field__input">
              <% Game::PLAYERS_RANGE.each do |n| %>
                <option value="<%= n %>" <%= "selected" if n == 4 %>><%= n %></option>
              <% end %>
            </select>
          </div>
        </div>

        <%= submit_tag "Создать комнату", class: "btn btn--primary btn--full" %>
      <% end %>
    </section>

    <section class="join-room">
      <h2 class="room-list__title">Войти по коду</h2>
      <%= form_with url: join_games_path, method: :post, local: true, class: "join-form" do |f| %>
        <div class="field">
          <%= f.text_field :code, placeholder: "Например, 7F3A9K", class: "field__input" %>
        </div>
        <%= f.submit "Войти", class: "btn btn--secondary" %>
      <% end %>
    </section>

    <section class="room-list">
      <h2 class="room-list__title">Публичные комнаты</h2>

      <% if @public_games.empty? %>
        <p class="room-list__empty">Пока нет публичных комнат — создайте первую.</p>
      <% else %>
        <div class="room-list__items">
          <% @public_games.each do |game| %>
            <div class="room-card">
              <div class="room-card__info">
                <p class="room-card__name">
                  Комната <%= game.code %>
                  <%= render "shared/status_badge", status: game.status %>
                </p>
                <p class="room-card__meta">
                  <%= game.players.size %>/<%= game.max_players %> игроков
                </p>
              </div>
              <% if game.players.exists?(user: current_user) %>
                <%= link_to "Продолжить", game_path(game), class: "btn btn--secondary" %>
              <% elsif game.status == "playing" %>
                <span class="btn btn--secondary" aria-disabled="true">Идёт игра</span>
              <% elsif game.full? %>
                <span class="btn btn--secondary" aria-disabled="true">Заполнена</span>
              <% else %>
                <%= button_to "Войти", join_games_path(code: game.code), method: :post, class: "btn btn--secondary" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</div>
