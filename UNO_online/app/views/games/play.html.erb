<% content_for :title, "Игра #{@game.code} — Uno Online" %>

<%# Подписка на личный поток стола: сервер присылает сюда обновления при каждом ходе %>
<%= turbo_stream_from @game, current_user %>

<div class="main-page">
  <header class="main-header">
    <%= render "shared/logo" %>
    <div style="display: flex; gap: var(--space-4); align-items: center;">
      <%= link_to "Обновить стол", play_game_path(@game), class: "main-header__logout" %>
      <%= button_to "Покинуть комнату", leave_game_path(@game), method: :post, class: "main-header__logout" %>
    </div>
  </header>

  <div class="main-content game-content">
    <h1>Комната <%= @game.code %></h1>
    <%= render "games/table", game: @game, viewer: current_user %>
  </div>
</div>
